rules_version = '2';

// ============================================================
// DOREAH — Firestore security rules
// Paste this into Firebase Console → Firestore Database → Rules → Publish.
// Replace the email below with the email you log into admin.html with.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['YOUR_ADMIN_EMAIL@gmail.com'];
    }

    // Anyone can see products and collection cards; only you can change them
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /collectionSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customers can CREATE an order record (when they tap "Order on WhatsApp"),
    // but only you can read, update or delete orders.
    match /orders/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['orderId', 'name', 'method', 'note', 'address', 'items', 'subtotal', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.orderId is string && request.resource.data.orderId.size() <= 20
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.method in ['Delivery', 'Pickup']
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number;
      allow read, update, delete: if isAdmin();
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
